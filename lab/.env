# .env du LAB DLMM — AUCUN secret ici (clé privée refusée au chargement par lab/run.sh).
# Base isolée + verrous paper posés par lab/run.sh (LAB_MODE=true, DLMM_DB_PATH).
# Chargé par src/config.ts UNIQUEMENT quand LAB_MODE=true.

# ════════════════════════════════════════════════════════════
# PHASE 2 — SCALING DU DÉBIT (démarrée 06/10, verdict 13/10)
# Base = calque EXACT de la prod relevé le 06/10 (toutes les clés ci-dessous
# sont aux valeurs prod SAUF celles marquées LEVIER). Objectif mesuré :
# vélocité médiane de frais > 2 %/j à 3-4× le capital déployé (~1 250 $ prod
# en moyenne → viser 4-5 000 $ simultanés). Backups : .env.bak-scaling-* ;
# base avant reset : data/lab.db.pre-reset-*.
# ════════════════════════════════════════════════════════════

# ── Filtres d'entrée (= prod, relevés 06/10) ──
MIN_TVL=150000
MIN_VOLUME_24H=10000
MIN_FEE_TVL_RATIO_24H=0.02
MIN_POOL_AGE_DAYS=1
MAX_VOL_24H=0.6
SCAN_TOP_POOLS=150
MIN_VOLUME_24H_BIDASK=150000
MIN_DIP_DRAWDOWN=0.3
MAX_TOPBLAST_POSITIONS=0
RUNNER_MIN_VOLUME_24H=500000
DIP_TARGET_RISKY=0.9
DIP_TARGET_SAFE=0.65
DIP_TARGET_RUNNER=0.8
MAX_DIP_BINS=400
MAX_POSITIONS_PER_TOKEN=1

# ── Book / sizing (= prod pour les clés non levier) ──
VALUE_STOP_LOSS=0.07
HARD_STOP_DAILY_DROP=0.40
REBALANCE_THRESHOLD=0.45
COOLING_EXIT_ENABLED=true
BOLLINGER_EXIT_ENABLED=true
MIN_CLAIM_USD=25
POST_CLOSE_VOL_MIN_24H=100000

# ── Cadence (= prod) ──
MONITOR_INTERVAL_MIN=15
API_REQUEST_DELAY_MS=120

# ════════════════════════════════════════════════════════════
# LEVIERS DE DÉBIT (seuls écarts assumés vs prod — phase 2)
# ════════════════════════════════════════════════════════════
# LEVIER 1 — book ×1,7 : jusqu'à 20 positions (prod 12 ; but réel observé ~2-3
# simultanées → ce qui sature le débit, ce sont les cooldowns, pas le book)
MAX_POSITIONS=20

# LEVIER 2 — cooldown ré-ouverture divisé par 3 après close (prod défaut 6 h)
TOKEN_REOPEN_COOLDOWN_HOURS=2

# LEVIER 3 — blacklist post-close raccourcie (prod défaut 48 h « chart mort »)
POST_CLOSE_BLACKLIST_HOURS=12

# LEVIER 4 — caps typés par volume : sizing satsmonkes PUR explicite avec
# classe major relevée 2000→3000 $ (TVL≥500k$ ET vol24h≥5M$). La prod plafonne
# à 500 $ via REAL_POSITION_USD_CAP ; le paper garde le sizing par classe.
SATS_SIZING_ENABLED=true
SATS_SIZE_EXPLORATORY_USD=500
SATS_SIZE_CONVICTION_USD=1000
SATS_SIZE_MAJOR_USD=3000
SATS_MAJOR_MIN_TVL=500000
SATS_MAJOR_MIN_VOLUME_24H=5000000
DEPOSIT_USD_PER_POSITION=2000
