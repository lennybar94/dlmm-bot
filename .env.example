# ============================================================
# DLMM BOT — configuration
# Copier vers .env puis ajuster. PAPER ONLY par défaut.
# ============================================================

# --- Réseau / API ---
DLMM_API_BASE=https://dlmm.datapi.meteora.ag
# RPC Solana : requis UNIQUEMENT pour le mode réel
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
API_REQUEST_DELAY_MS=120
API_MAX_RETRIES=3

# --- Mode (PAPER ONLY sauf décision explicite) ---
REAL_MODE=false
# Pour activer le réel (DÉCONSEILLÉ sans revue) : REAL_MODE=true ET REAL_CONFIRM=CONFIRMED-REAL-MODE
REAL_CONFIRM=changeme
WALLET_PRIVATE_KEY=

# --- Filtres du scan d'opportunités ---
MIN_TVL=50000
MIN_VOLUME_24H=10000
MIN_FEE_TVL_RATIO_24H=0.02
MIN_POOL_AGE_DAYS=1
# Volatilité journalière max — 0,12 = même garde qu'avant le fix √24 (l'ancien 0,6 était
# calibré sur un σ gonflé ×√24 ; bug NOTES-20261025 §2-1 corrigé au commit 1 de la PR).
MAX_VOL_24H=0.12
SCAN_TOP_POOLS=150

# --- Stratégies / positions paper ---
MAX_POSITIONS=6
DEPOSIT_USD_PER_POSITION=1000
REBALANCE_THRESHOLD=0.45
HARD_STOP_DAILY_DROP=0.40
MIN_CLAIM_USD=25
MONITOR_INTERVAL_MIN=15

# --- Apprentissage (reviews + auto-réglage) ---
TUNE_MIN_SAMPLES=10
TUNE_MIN_HOURS_BETWEEN=24
WEEKLY_REVIEW_DAYS=7

# --- Dashboard ---
DASHBOARD_PORT=4001
DASHBOARD_HOST=0.0.0.0
DASHBOARD_LIVE=true

# --- Wallet (mode réel uniquement) ---
# Adresse PUBLIQUE du wallet pilote (obligatoire si REAL_MODE=true)
WALLET_ADDRESS=

# Volatilité journalière max — 0,12 = même garde qu'avant le fix √24 (l'ancien 0,6 était
# calibré sur un σ gonflé ×√24 ; bug NOTES-20261025 §2-1 corrigé).
MAX_VOL_24H=0.12

# ── Porte S1 frais/LVR (NOTES-20261025 §8 — formule DLMM-Claude en bloc) ──
# R = 2·W·f/σ² ≥ 2,5 (24 h) ET ≥ 2,0 (rythme 1 h ×24), plancher fees 0,25 %/j,
# σ intraday 4 h sur la série pool_scans, ≥12 rendements sinon refus dur.
S1_GATE_ENABLED=true
S1_RMIN=2.5
S1_RMIN_1H=2.0
S1_MIN_FEE_DAILY=0.0025
S1_SIGMA_WINDOW_HOURS=4
S1_SIGMA_MIN_RETURNS=12
S1_POOL_WIDTH_PER_SIGMA=9
S1_POOL_WIDTH_MIN=0.01
S1_POOL_WIDTH_MAX=0.25
